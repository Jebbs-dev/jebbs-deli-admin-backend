{
  "name": "jebbs-deli-admin-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/apps/api/main.js",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc -p apps/api/tsconfig.app.json && node scripts/rewrite-dist-aliases.js",
    "start": "node -r ./scripts/register-path-aliases.js dist/apps/api/main.js",
    "dev": "node scripts/dev-api.js",
    "dev:run": "node --watch -r ./scripts/register-path-aliases.js dist/apps/api/main.js",
    "start:debug": "node scripts/dev-api.js",
    "start:prod": "node dist/apps/api/main.js",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit",
    "lint": "eslint \"{apps,libs,emails,prisma,scripts}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{apps,libs,emails,prisma,scripts}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{apps,libs,emails,prisma}/**/*.{ts,tsx,json}\" \"scripts/*.{js,ts,mjs}\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"{apps,libs,emails,prisma}/**/*.{ts,tsx,json}\" \"scripts/*.{js,ts,mjs}\" \"*.{json,mjs,md}\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:seed": "node scripts/run-ts.js prisma/seed.ts",
    "seed": "pnpm run db:seed",
    "email:dev": "email dev --dir emails",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^0.5.7",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "react": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.1.2",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "orval": "^8.22.0",
    "prettier": "^3.9.6",
    "react-email": "^4.2.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
